# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/
build/
*.o
*.a
*.out
# Host-side utilities compiled on Windows
*.exe

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
# Generated in build directory
flasher_args.json
sdkconfig.old
sdkconfig

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
# General workspace files, can be from various tools
*.workspace
# Visual Studio Solution User Options
*.suo
# Visual Studio
*.sln.docstates

# ---------------------------------------------------------------
# Shared project setup (what makes a fresh clone open and build)
# ---------------------------------------------------------------
# TRACKED on purpose:
#   .devcontainer/        reproducible ESP-IDF toolchain (Docker)
#   .vscode/launch.json, .vscode/c_cpp_properties.json   portable editor config
#   .clangd               portable (only removes GCC-only flags)
#   dependencies.lock     pins component versions
#   sdkconfig.defaults    committed config; replaces the ignored sdkconfig

# IGNORED: the ESP-IDF extension rewrites this with absolute paths
# (IDF install dir, COM port, clangd path), which break on other machines
.vscode/settings.json

